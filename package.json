{
  "name": "omp-opencode-bridge",
  "version": "2.6.0",
  "description": "OpenCode free-tier models for OMP/pi: a local OpenAI-compatible bridge (no account required) plus the keyless provider plugin",
  "main": "server.ts",
  "bin": {
    "opencode-free-bridge": "server.ts"
  },
  "scripts": {
    "start": "bun server.ts",
    "test": "bun test test/*.test.js",
    "drill": "bun gate-drill.ts",
    "verify": "bun verify.ts",
    "verify:quick": "bun verify.ts --quick",
    "fingerprint": "bun transport-fingerprint.ts",
    "fingerprint:check": "bun transport-fingerprint.ts --check",
    "start:node": "node server.ts",
    "test:node": "node --test test/*.test.js",
    "drill:node": "node gate-drill.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "server.ts",
    "identity.ts",
    "token-budget.ts",
    "verify.ts",
    "gate-drill.ts",
    "README.md",
    "AGENTS.md",
    "install.sh",
    "THIRD_PARTY_NOTICES.md",
    "egress-proxy.ts",
    "transport-fingerprint.ts",
    "transport-baseline.json",
    "tunnel-doctor.sh",
    "proxy.ts",
    "panel.ts",
    "anthropic.ts",
    "src"
  ],
  "keywords": [
    "opencode",
    "openai",
    "bridge",
    "proxy",
    "free",
    "llm",
    "9router",
    "cursor",
    "continue",
    "vscode",
    "pi-package",
    "pi-extension",
    "omp",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yayayapluto/omp-opencode-bridge.git"
  },
  "homepage": "https://github.com/yayayapluto/omp-opencode-bridge#readme",
  "bugs": {
    "url": "https://github.com/yayayapluto/omp-opencode-bridge/issues"
  },
  "license": "MIT"
}